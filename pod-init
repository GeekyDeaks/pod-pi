#!/usr/bin/env bash
set -euo pipefail

IMAGE="${PI_PODMAN_IMAGE:-localhost/pi-agent:base}"
PI_VOLUME="pi-agent-pi"

if [[ "$#" -ne 0 ]]; then
  echo "usage: $0" >&2
  exit 2
fi

if ! podman volume exists "$PI_VOLUME"; then
  podman volume create "$PI_VOLUME" >/dev/null
fi

podman run --rm \
  --userns=keep-id \
  --user "$(id -u):$(id -g)" \
  --security-opt=no-new-privileges \
  --cap-drop=ALL \
  --tmpfs /tmp:rw,exec,nosuid,nodev,size=1g \
  -e HOME=/home/pi \
  -v "${PI_VOLUME}:/home/pi/.pi:rw,U,z" \
  --entrypoint /bin/sh \
  "$IMAGE" \
  -c 'mkdir -p "$HOME/.pi/agent"; cp -a --no-preserve=ownership /usr/local/share/pi-agent/. "$HOME/.pi/agent/"'

echo "merged bundled agent assets into podman volume ${PI_VOLUME}"
