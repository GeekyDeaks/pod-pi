#!/usr/bin/env bash
set -euo pipefail

IMAGE="${PI_PODMAN_IMAGE:-localhost/pi-agent:base}"
PI_VOLUME="pi-agent-home"
PI_SUBAGENTS_VERSION="${PI_SUBAGENTS_VERSION:-0.19.0}"

if [[ "$#" -ne 0 ]]; then
  echo "usage: $0" >&2
  exit 2
fi

if ! podman volume exists "$PI_VOLUME"; then
  podman volume create "$PI_VOLUME" >/dev/null
fi

podman run --rm \
  --userns=keep-id:uid=1000,gid=1000 \
  --security-opt=no-new-privileges \
  --cap-drop=ALL \
  --tmpfs /tmp:rw,exec,nosuid,nodev,size=1g \
  -e HOME=/home/pi \
  -e PI_SUBAGENTS_VERSION="${PI_SUBAGENTS_VERSION}" \
  -v "${PI_VOLUME}:/home/pi:rw,U,z" \
  "$IMAGE" \
  pi-agent-init

echo "initialized podman volume ${PI_VOLUME} (bundled assets and pi-subagents ${PI_SUBAGENTS_VERSION})"
