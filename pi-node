#!/usr/bin/env bash
set -euo pipefail

IMAGE="${PI_PODMAN_IMAGE:-localhost/pi-agent:latest}"
PI_DIR="${HOME}/.pi"
WORKDIR="${PWD}"

if [[ ! -d "$PI_DIR" ]]; then
  echo "missing ${PI_DIR}" >&2
  exit 1
fi

podman_args=(
  run
  --rm
  --userns=keep-id
  --user "$(id -u):$(id -g)"
  --security-opt=no-new-privileges
  --cap-drop=ALL
  --tmpfs /tmp:rw,exec,nosuid,nodev,size=1g
  --tmpfs /home/pi:rw,exec,nosuid,nodev,size=128m
  -e HOME=/home/pi
  -v "${PI_DIR}:/mnt/pi-config:ro,z"
  -v "${WORKDIR}:/work:z"
  -w /work
)

declare -A symlink_targets=()
while IFS= read -r -d '' link; do
  target="$(realpath "$link" 2>/dev/null || true)"
  [[ -n "$target" && -e "$target" ]] || continue
  [[ "$target" == "$PI_DIR" || "$target" == "$PI_DIR"/* ]] && continue
  symlink_targets["$target"]=1
done < <(find "$PI_DIR" -type l -print0)

for target in "${!symlink_targets[@]}"; do
  podman_args+=( -v "${target}:${target}:ro,z" )
done

if [[ -t 0 && -t 1 ]]; then
  podman_args+=( -it )
fi

exec podman "${podman_args[@]}" "$IMAGE" "$@"
