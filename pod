#!/usr/bin/env bash
set -euo pipefail

IMAGE="${PI_PODMAN_IMAGE:-localhost/pi-agent:base}"
PI_VOLUME="pi-agent-home"
WORKDIR="${PWD}"

PI_SKIP_VERSION_CHECK=true

if ! podman volume exists "$PI_VOLUME"; then
  echo "missing podman volume ${PI_VOLUME}" >&2
  echo "run ./pod-init to create and initialize it" >&2
  exit 1
fi

if [[ "$#" -eq 0 ]]; then
  if command -v bash >/dev/null 2>&1; then
    set -- bash
  else
    set -- sh
  fi
fi

podman_args=(
  run
  --rm
  --userns=keep-id:uid=1000,gid=1000
  --security-opt=no-new-privileges
  --cap-drop=ALL
  --tmpfs /tmp:rw,exec,nosuid,nodev,size=1g
)

if [[ -f "${WORKDIR}/.env" ]]; then
  podman_args+=( --env-file "${WORKDIR}/.env" )
fi

podman_args+=(
  -e HOME=/home/pi
  -v "${PI_VOLUME}:/home/pi:rw,z"
  -v "${WORKDIR}:/work:z"
  -w /work
)

if [[ -t 0 && -t 1 ]]; then
  podman_args+=( -it )
fi

exec podman "${podman_args[@]}" "$IMAGE" "$@"
