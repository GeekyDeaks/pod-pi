#!/usr/bin/env bash
set -euo pipefail

IMAGE="${PI_PODMAN_IMAGE:-localhost/pi-agent:latest}"
PI_VOLUME="${PI_PODMAN_PI_VOLUME:-pi-agent-pi}"
WORKDIR="${PWD}"

if ! podman volume exists "$PI_VOLUME"; then
  echo "missing podman volume ${PI_VOLUME}" >&2
  echo "run ./pod-init to create it from ${HOME}/.pi" >&2
  exit 1
fi

if [[ "$#" -eq 0 ]]; then
  if command -v bash >/dev/null 2>&1; then
    set -- bash
  else
    set -- sh
  fi
fi

podman_args=(
  run
  --rm
  --userns=keep-id
  --user "$(id -u):$(id -g)"
  --security-opt=no-new-privileges
  --cap-drop=ALL
  --tmpfs /tmp:rw,exec,nosuid,nodev,size=1g
  --tmpfs /home/pi:rw,exec,nosuid,nodev,size=128m
  -e HOME=/home/pi
  -v "${PI_VOLUME}:/home/pi/.pi:rw,z"
  -v "${WORKDIR}:/work:z"
  -w /work
)

if [[ -t 0 && -t 1 ]]; then
  podman_args+=( -it )
fi

exec podman "${podman_args[@]}" "$IMAGE" "$@"
